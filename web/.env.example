# Copy to .env.local (gitignored) to point local dev at a local backend.
#
# Without this, VITE_CORE_URL is unset and web/src/api.js's CORE constant
# falls back to the LIVE PRODUCTION Cloud Run URL -- so `npm run dev` talks
# to production by default, not to a backend you're running locally. That
# is deliberate for a zero-config "just works" checkout, but it means a
# 404/405/CORS error during local dev is often not a real API bug, just
# this browser hitting production instead of your local `uvicorn
# app.api:app` -- check the Network tab's request origin (or the error
# message, which now includes it) before assuming the backend is broken.
#
# To run against a local backend instead:
#   1. AXON_FIRESTORE_MODE=memory uvicorn app.api:app --reload --port 8080
#   2. Set VITE_CORE_URL below to that backend's URL
#   3. Restart `npm run dev` (Vite only reads this file at startup)
VITE_CORE_URL=http://localhost:8080
